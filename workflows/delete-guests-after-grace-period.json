{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "description": "Deletes Entra ID guest users that have been previously marked for removal. Checks extensionAttribute14 for 'MarkedEligibleforRemoval' and extensionAttribute15 for timestamp. Deletes users if threshold is exceeded and account is disabled. Includes dry-run mode and comprehensive error handling.",
  "parameters": {
    "guestSourceGroupId": {
      "type": "String",
      "defaultValue": ""
    },
    "DeletionThresholdDays": {
      "type": "Int",
      "defaultValue": 30
    },
    "ReportOnly": {
      "type": "Bool",
      "defaultValue": true
    },
    "ExcludeFlagValue": {
      "type": "String",
      "defaultValue": "ExcludeFromLCM"
    },
    "BatchSize": {
      "type": "Int",
      "defaultValue": 20
    }
  },
  "triggers": {
    "Recurrence": {
      "recurrence": {
        "frequency": "Week",
        "interval": 1,
        "schedule": {
          "weekDays": [
            "Sunday"
          ],
          "hours": [
            3
          ],
          "minutes": [
            0
          ]
        }
      },
      "type": "Recurrence"
    }
  },
  "actions": {
    "Initialize_DeletionThreshold": {
      "runAfter": {},
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "DeletionThreshold",
            "type": "string",
            "value": "@{formatDateTime(subtractFromTime(utcNow(), parameters('DeletionThresholdDays'), 'Day'),'yyyy-MM-ddTHH:mm:ssZ')}"
          }
        ]
      }
    },
    "Initialize_DeletedUsersReport": {
      "runAfter": {
        "Initialize_DeletionThreshold": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "DeletedUsersReport",
            "type": "array",
            "value": []
          }
        ]
      }
    },
    "Initialize_NextLink": {
      "runAfter": {
        "Initialize_DeletedUsersReport": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "NextLink",
            "type": "string",
            "value": "@{concat('https://graph.microsoft.com/v1.0/groups/',encodeURIComponent(parameters('guestSourceGroupId')),'/members?$select=id&$top=999')}"
          }
        ]
      }
    },
    "Initialize_AllMembers": {
      "runAfter": {
        "Initialize_NextLink": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "AllMembers",
            "type": "array",
            "value": []
          }
        ]
      }
    },
    "Initialize_HasApiError": {
      "runAfter": {
        "Initialize_AllMembers": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "HasApiError",
            "type": "boolean",
            "value": false
          }
        ]
      }
    },
    "Initialize_ApiErrorMessage": {
      "runAfter": {
        "Initialize_HasApiError": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ApiErrorMessage",
            "type": "string",
            "value": ""
          }
        ]
      }
    },
    "Initialize_TotalProcessedUsers": {
      "runAfter": {
        "Initialize_ApiErrorMessage": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "TotalProcessedUsers",
            "type": "integer",
            "value": 0
          }
        ]
      }
    },
    "Initialize_SuccessfulDeletes": {
      "runAfter": {
        "Initialize_TotalProcessedUsers": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "SuccessfulDeletes",
            "type": "integer",
            "value": 0
          }
        ]
      }
    },
    "Initialize_HasRateLimit": {
      "runAfter": {
        "Initialize_SuccessfulDeletes": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "HasRateLimit",
            "type": "boolean",
            "value": false
          }
        ]
      }
    },
    "Initialize_DeleteRequests": {
      "runAfter": {
        "Initialize_HasRateLimit": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "DeleteRequests",
            "type": "array",
            "value": []
          }
        ]
      }
    },
    "Initialize_RemainingMembers": {
      "runAfter": {
        "Initialize_DeleteRequests": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "RemainingMembers",
            "type": "array",
            "value": []
          }
        ]
      }
    },
    "Initialize_FailedDeletes": {
      "runAfter": {
        "Initialize_RemainingMembers": [
          "Succeeded"
        ]
      },
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "FailedDeletes",
            "type": "array",
            "value": []
          }
        ]
      }
    },
    "Do_Until_All_Pages": {
      "actions": {
        "GetMembersPage": {
          "type": "Http",
          "inputs": {
            "uri": "@{variables('NextLink')}",
            "method": "GET",
            "authentication": {
              "type": "ManagedServiceIdentity",
              "audience": "https://graph.microsoft.com"
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 3,
              "interval": "PT20S"
            }
          }
        },
        "Check_GetMembersPage_Error": {
          "actions": {
            "SetApiErrorFlag": {
              "type": "SetVariable",
              "inputs": {
                "name": "HasApiError",
                "value": true
              }
            },
            "SetApiErrorMessage": {
              "runAfter": {
                "SetApiErrorFlag": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "ApiErrorMessage",
                "value": "@{concat('API Error (', outputs('GetMembersPage')?['statusCode'], '): ', coalesce(outputs('GetMembersPage')?['body']?['error']?['message'], 'Unknown error'))}"
              }
            }
          },
          "runAfter": {
            "GetMembersPage": [
              "Succeeded",
              "Failed",
              "TimedOut",
              "Skipped"
            ]
          },
          "else": {
            "actions": {}
          },
          "expression": {
            "or": [
              {
                "not": {
                  "equals": [
                    "@outputs('GetMembersPage')?['statusCode']",
                    200
                  ]
                }
              },
              {
                "equals": [
                  "@outputs('GetMembersPage')?['statusCode']",
                  400
                ]
              },
              {
                "equals": [
                  "@outputs('GetMembersPage')?['statusCode']",
                  401
                ]
              },
              {
                "equals": [
                  "@outputs('GetMembersPage')?['statusCode']",
                  403
                ]
              },
              {
                "equals": [
                  "@outputs('GetMembersPage')?['statusCode']",
                  404
                ]
              },
              {
                "equals": [
                  "@outputs('GetMembersPage')?['statusCode']",
                  429
                ]
              },
              {
                "equals": [
                  "@outputs('GetMembersPage')?['statusCode']",
                  500
                ]
              },
              {
                "equals": [
                  "@outputs('GetMembersPage')?['statusCode']",
                  503
                ]
              }
            ]
          },
          "type": "If"
        },
        "AppendMembers": {
          "foreach": "@coalesce(body('GetMembersPage')?['value'], createArray())",
          "actions": {
            "AppendSingleMember": {
              "type": "AppendToArrayVariable",
              "inputs": {
                "name": "AllMembers",
                "value": "@item()"
              }
            }
          },
          "runAfter": {
            "Check_GetMembersPage_Error": [
              "Succeeded",
              "Skipped"
            ]
          },
          "type": "Foreach"
        },
        "SetNextLink": {
          "runAfter": {
            "AppendMembers": [
              "Succeeded",
              "Skipped"
            ]
          },
          "type": "SetVariable",
          "inputs": {
            "name": "NextLink",
            "value": "@if(empty(body('GetMembersPage')?['@odata.nextLink']),'',body('GetMembersPage')?['@odata.nextLink'])"
          }
        }
      },
      "runAfter": {
        "Initialize_FailedDeletes": [
          "Succeeded"
        ]
      },
      "expression": "@or(equals(variables('NextLink'),''),equals(variables('HasApiError'),true))",
      "limit": {
        "count": 500,
        "timeout": "PT30M"
      },
      "type": "Until"
    },
    "Check_If_GetMembersPageApiError": {
      "actions": {
        "Terminate_OnApiError": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "message": "@variables('ApiErrorMessage')"
            }
          }
        }
      },
      "runAfter": {
        "Do_Until_All_Pages": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ]
      },
      "else": {
        "actions": {}
      },
      "expression": {
        "equals": [
          "@variables('HasApiError')",
          true
        ]
      },
      "type": "If"
    },
    "Check_If_Members_Exist": {
      "actions": {
        "Do_Until_Process_All_Batches": {
          "actions": {
            "Reset_DeleteRequests": {
              "type": "SetVariable",
              "inputs": {
                "name": "DeleteRequests",
                "value": []
              }
            },
            "Select_BatchRequests": {
              "runAfter": {
                "Reset_DeleteRequests": [
                  "Succeeded"
                ]
              },
              "type": "Select",
              "inputs": {
                "from": "@take(variables('AllMembers'), parameters('BatchSize'))",
                "select": {
                  "id": "@item()?['id']",
                  "method": "GET",
                  "url": "@concat('/users/', item()?['id'], '?$select=id,displayName,userPrincipalName,mail,accountEnabled,onPremisesExtensionAttributes')"
                }
              }
            },
            "Compose_BatchPayload": {
              "runAfter": {
                "Select_BatchRequests": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": {
                "requests": "@body('Select_BatchRequests')"
              }
            },
            "GetUserInfosBatch": {
              "runAfter": {
                "Compose_BatchPayload": [
                  "Succeeded"
                ]
              },
              "type": "Http",
              "inputs": {
                "uri": "https://graph.microsoft.com/beta/$batch",
                "method": "POST",
                "body": "@outputs('Compose_BatchPayload')",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://graph.microsoft.com"
                },
                "retryPolicy": {
                  "type": "exponential",
                  "count": 3,
                  "interval": "PT20S"
                }
              }
            },
            "Check_GetUserInfosBatch_Error": {
              "actions": {
                "Check_If_Rate_Limit": {
                  "actions": {
                    "Set_Rate_Limit_Flag": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "HasRateLimit",
                        "value": true
                      }
                    },
                    "Set_Rate_Limit_Error": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "ApiErrorMessage",
                        "value": "@{concat('Graph API rate limit reached after processing ', string(variables('TotalProcessedUsers')), ' users.')}"
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "expression": {
                    "equals": [
                      "@outputs('GetUserInfosBatch')?['statusCode']",
                      429
                    ]
                  },
                  "type": "If"
                }
              },
              "runAfter": {
                "GetUserInfosBatch": [
                  "Succeeded",
                  "Failed",
                  "TimedOut",
                  "Skipped"
                ]
              },
              "else": {
                "actions": {}
              },
              "expression": {
                "not": {
                  "equals": [
                    "@outputs('GetUserInfosBatch')?['statusCode']",
                    200
                  ]
                }
              },
              "type": "If"
            },
            "For_each_BatchResponse": {
              "foreach": "@coalesce(body('GetUserInfosBatch')?['responses'], createArray())",
              "actions": {
                "Check_Response_Success": {
                  "actions": {
                    "Increment_TotalProcessed": {
                      "type": "IncrementVariable",
                      "inputs": {
                        "name": "TotalProcessedUsers",
                        "value": 1
                      }
                    },
                    "Check_If_Marked_For_Deletion": {
                      "actions": {
                        "Check_If_Past_Threshold": {
                          "actions": {
                            "Add_To_Delete_Report": {
                              "type": "AppendToArrayVariable",
                              "inputs": {
                                "name": "DeletedUsersReport",
                                "value": {
                                  "userId": "@item()?['body']?['id']",
                                  "displayName": "@item()?['body']?['displayName']",
                                  "userPrincipalName": "@item()?['body']?['userPrincipalName']",
                                  "mail": "@item()?['body']?['mail']",
                                  "markedDate": "@item()?['body']?['onPremisesExtensionAttributes']?['extensionAttribute15']",
                                  "daysSinceMarked": "@div(sub(ticks(utcNow()), ticks(item()?['body']?['onPremisesExtensionAttributes']?['extensionAttribute15'])), 864000000000)",
                                  "actionTaken": "@if(parameters('ReportOnly'),'REPORT ONLY','DELETED')",
                                  "timestamp": "@utcNow()"
                                }
                              }
                            },
                            "Add_To_Delete_Batch": {
                              "actions": {
                                "Append_Delete_Request": {
                                  "type": "AppendToArrayVariable",
                                  "inputs": {
                                    "name": "DeleteRequests",
                                    "value": {
                                      "id": "@concat('delete-', item()?['body']?['id'])",
                                      "method": "DELETE",
                                      "url": "@concat('/users/', item()?['body']?['id'])"
                                    }
                                  }
                                }
                              },
                              "runAfter": {
                                "Add_To_Delete_Report": [
                                  "Succeeded"
                                ]
                              },
                              "else": {
                                "actions": {}
                              },
                              "expression": {
                                "equals": [
                                  "@parameters('ReportOnly')",
                                  false
                                ]
                              },
                              "type": "If"
                            }
                          },
                          "else": {
                            "actions": {}
                          },
                          "expression": {
                            "less": [
                              "@item()?['body']?['onPremisesExtensionAttributes']?['extensionAttribute15']",
                              "@variables('DeletionThreshold')"
                            ]
                          },
                          "type": "If"
                        }
                      },
                      "runAfter": {
                        "Increment_TotalProcessed": [
                          "Succeeded"
                        ]
                      },
                      "else": {
                        "actions": {}
                      },
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@item()?['body']?['onPremisesExtensionAttributes']?['extensionAttribute14']",
                              "MarkedEligibleforRemoval"
                            ]
                          },
                          {
                            "not": {
                              "equals": [
                                "@item()?['body']?['onPremisesExtensionAttributes']?['extensionAttribute15']",
                                null
                              ]
                            }
                          },
                          {
                            "equals": [
                              "@item()?['body']?['accountEnabled']",
                              false
                            ]
                          }
                        ]
                      },
                      "type": "If"
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "expression": {
                    "equals": [
                      "@item()?['status']",
                      200
                    ]
                  },
                  "type": "If"
                }
              },
              "runAfter": {
                "Check_GetUserInfosBatch_Error": [
                  "Succeeded",
                  "Skipped"
                ]
              },
              "type": "Foreach"
            },
            "Check_HasDeleteRequests": {
              "actions": {
                "Compose_DeleteBatchPayload": {
                  "type": "Compose",
                  "inputs": {
                    "requests": "@variables('DeleteRequests')"
                  }
                },
                "Execute_DeleteBatch": {
                  "runAfter": {
                    "Compose_DeleteBatchPayload": [
                      "Succeeded"
                    ]
                  },
                  "type": "Http",
                  "inputs": {
                    "uri": "https://graph.microsoft.com/beta/$batch",
                    "method": "POST",
                    "body": "@outputs('Compose_DeleteBatchPayload')",
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "audience": "https://graph.microsoft.com"
                    },
                    "retryPolicy": {
                      "type": "exponential",
                      "count": 3,
                      "interval": "PT20S"
                    }
                  }
                },
                "Count_Successful_Deletes": {
                  "foreach": "@coalesce(body('Execute_DeleteBatch')?['responses'], createArray())",
                  "actions": {
                    "Check_If_Delete_Success": {
                      "actions": {
                        "Increment_Success_Count": {
                          "type": "IncrementVariable",
                          "inputs": {
                            "name": "SuccessfulDeletes",
                            "value": 1
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Append_To_Failed_Deletes": {
                            "type": "AppendToArrayVariable",
                            "inputs": {
                              "name": "FailedDeletes",
                              "value": {
                                "userId": "@item()?['id']",
                                "status": "@item()?['status']",
                                "errorMessage": "@item()?['body']?['error']?['message']"
                              }
                            }
                          }
                        }
                      },
                      "expression": {
                        "equals": [
                          "@item()?['status']",
                          204
                        ]
                      },
                      "type": "If"
                    }
                  },
                  "runAfter": {
                    "Execute_DeleteBatch": [
                      "Succeeded"
                    ]
                  },
                  "type": "Foreach"
                }
              },
              "runAfter": {
                "For_each_BatchResponse": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {}
              },
              "expression": "@and(not(parameters('ReportOnly')),greater(length(variables('DeleteRequests')),0))",
              "type": "If"
            },
            "Check_Execute_DeleteBatch_Error": {
              "actions": {
                "Check_If_Rate_Limit_Delete": {
                  "actions": {
                    "Set_Rate_Limit_Delete": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "HasRateLimit",
                        "value": true
                      }
                    },
                    "Set_Rate_Limit_Delete_Message": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "ApiErrorMessage",
                        "value": "@{concat('Rate limit during delete operations. Processed: ', string(variables('TotalProcessedUsers')), ', Deleted: ', string(variables('SuccessfulDeletes')))}"
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "expression": {
                    "equals": [
                      "@outputs('Execute_DeleteBatch')?['statusCode']",
                      429
                    ]
                  },
                  "type": "If"
                }
              },
              "runAfter": {
                "Check_HasDeleteRequests": [
                  "Succeeded",
                  "Failed",
                  "TimedOut",
                  "Skipped"
                ]
              },
              "else": {
                "actions": {}
              },
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@length(variables('DeleteRequests'))",
                      0
                    ]
                  },
                  {
                    "not": {
                      "equals": [
                        "@parameters('ReportOnly')",
                        true
                      ]
                    }
                  },
                  {
                    "not": {
                      "equals": [
                        "@outputs('Execute_DeleteBatch')?['statusCode']",
                        200
                      ]
                    }
                  }
                ]
              },
              "type": "If"
            },
            "Set_RemainingMembers": {
              "runAfter": {
                "Check_Execute_DeleteBatch_Error": [
                  "Succeeded",
                  "Skipped"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "RemainingMembers",
                "value": "@skip(variables('AllMembers'), min(parameters('BatchSize'), length(variables('AllMembers'))))"
              }
            },
            "Remove_Processed_Users": {
              "runAfter": {
                "Set_RemainingMembers": [
                  "Succeeded"
                ]
              },
              "type": "SetVariable",
              "inputs": {
                "name": "AllMembers",
                "value": "@variables('RemainingMembers')"
              }
            }
          },
          "expression": "@or(equals(length(variables('AllMembers')), 0), equals(variables('HasRateLimit'), true))",
          "limit": {
            "count": 500,
            "timeout": "PT2H"
          },
          "type": "Until"
        }
      },
      "runAfter": {
        "Check_If_GetMembersPageApiError": [
          "Succeeded",
          "Skipped"
        ]
      },
      "else": {
        "actions": {}
      },
      "expression": {
        "greater": [
          "@length(variables('AllMembers'))",
          0
        ]
      },
      "type": "If"
    },
    "Check_If_Rate_Limit_Occurred": {
      "actions": {
        "Terminate_Due_To_Rate_Limit": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "message": "@variables('ApiErrorMessage')"
            }
          }
        }
      },
      "runAfter": {
        "Check_If_Members_Exist": [
          "Succeeded",
          "Skipped",
          "Failed",
          "TimedOut"
        ]
      },
      "else": {
        "actions": {}
      },
      "expression": {
        "equals": [
          "@variables('HasRateLimit')",
          true
        ]
      },
      "type": "If"
    },
    "Check_If_Failed_Deletes_Exist": {
      "actions": {
        "Terminate_Due_To_Failed_Deletes": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "message": "@{concat('Failed to delete some users: ', string(variables('FailedDeletes')))}"
            }
          }
        }
      },
      "runAfter": {
        "Check_If_Rate_Limit_Occurred": [
          "Succeeded",
          "Skipped",
          "Failed",
          "TimedOut"
        ]
      },
      "else": {
        "actions": {}
      },
      "expression": {
        "greater": [
          "@length(variables('FailedDeletes'))",
          0
        ]
      },
      "type": "If"
    },
    "Generate_Final_Report": {
      "runAfter": {
        "Check_If_Failed_Deletes_Exist": [
          "Succeeded",
          "Skipped",
          "Failed",
          "TimedOut"
        ]
      },
      "type": "Compose",
      "inputs": {
        "reportMetadata": {
          "runId": "@workflow()?['run']?['name']",
          "runDate": "@formatDateTime(utcNow(),'yyyy-MM-dd HH:mm:ss')",
          "runDateISO": "@utcNow()",
          "mode": "@if(parameters('ReportOnly'),'Report Only','Production')",
          "deletionThresholdDays": "@parameters('DeletionThresholdDays')",
          "deletionThresholdDate": "@variables('DeletionThreshold')",
          "batchSize": "@parameters('BatchSize')",
          "totalProcessedUsers": "@variables('TotalProcessedUsers')",
          "usersDeleted": "@length(variables('DeletedUsersReport'))",
          "successfulDeletes": "@variables('SuccessfulDeletes')",
          "guestSourceGroupId": "@parameters('guestSourceGroupId')",
          "failedDeletes": "@variables('FailedDeletes')"
        },
        "summary": {
          "totalMarkedUsersFound": "@length(variables('DeletedUsersReport'))",
          "accountsDeleted": "@if(parameters('ReportOnly'),0,variables('SuccessfulDeletes'))",
          "reportOnlyMode": "@parameters('ReportOnly')",
          "failedDeletesCount": "@length(variables('FailedDeletes'))",
          "message": "@if(equals(length(variables('DeletedUsersReport')),0),'No users found for deletion.', concat(string(length(variables('DeletedUsersReport'))), ' users processed for deletion'))"
        },
        "deletedUsers": "@variables('DeletedUsersReport')",
        "failedDeletes": "@variables('FailedDeletes')",
        "configuration": {
          "audience": "https://graph.microsoft.com",
          "reportOnly": "@parameters('ReportOnly')",
          "deletionThresholdDays": "@parameters('DeletionThresholdDays')",
          "batchSize": "@parameters('BatchSize')",
          "guestSourceGroupId": "@parameters('guestSourceGroupId')"
        }
      }
    }
  }
}
